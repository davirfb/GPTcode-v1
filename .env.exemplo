# Copie para .env (nunca versione o .env) e preencha.
FLASK_SECRET_KEY=uma_chave_longa_e_aleatoria

# Firebase (Console do Firebase > Configurações do projeto > Seus apps)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=

# Conta de serviço (Firebase Admin SDK): o JSON em uma linha, OU o caminho do arquivo fora desta pasta
FIREBASE_SERVICE_ACCOUNT_JSON=
# FIREBASE_SERVICE_ACCOUNT_PATH=/caminho/seguro/firebase-service-account.json

# Quem pode entrar no painel: só estes e-mails (separados por vírgula, sem espaço)
ADMIN_ALLOWED_EMAILS=proprietario@exemplo.com,outra.pessoa@exemplo.com

# Endereço público do site (links dos e-mails de aviso)
SITE_URL=https://www.seudominio.com.br

# Opcional: token para a API (Authorization: Bearer ...)
API_TOKEN=
# Opcional: e-mail de aviso de novas submissões (Gmail com senha de app)
NOTIFICATION_EMAIL_FROM=
NOTIFICATION_EMAIL_APP_PASSWORD=
# Opcional: caminho do banco (use uma pasta que não seja apagada em atualizações)
# GPTCODE_DB_PATH=
